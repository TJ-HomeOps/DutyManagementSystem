generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DutyRuleType {
  FIXED
  MANUAL
  ROTATION
}

model Team {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  color       String?

  employees       Employee[]
  dutyRules       DutyRule[]
  dutyAssignments DutyAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id String @id @default(cuid())

  name       String
  department String

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  dutyRules       DutyRule[]
  dutyAssignments DutyAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DutyRule {
  id String @id @default(cuid())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  weekday Weekday

  ruleType DutyRuleType

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([weekday])
}

model DutyAssignment {
  id String @id @default(cuid())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  start DateTime
  end   DateTime

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([employeeId])
  @@index([start])
  @@index([end])
}
