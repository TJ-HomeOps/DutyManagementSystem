generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DutyRuleType {
  FIXED
  MANUAL
  ROTATION
}

model Team {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  color       String?

  employees       Employee[]
  dutyRules       DutyRule[]
  dutyAssignments DutyAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id String @id @default(cuid())

  name       String
  department String

  // Matched case-insensitively against a User's Entra email on login to
  // auto-link that login to this employee — see User below.
  email String? @unique

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  dutyRules       DutyRule[]
  dutyAssignments DutyAssignment[]
  holidays        Holiday[]
  user            User?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A real per-person identity, provisioned just-in-time on first Entra
// login (not synced from the whole directory) and refreshed on every
// subsequent login. Logging in with the shared local password never
// creates or touches a User — that path stays fully anonymous/shared,
// exactly as before.
model User {
  id             String @id @default(cuid())
  entraObjectId  String @unique
  email          String
  name           String

  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  sessions Session[]

  createdAt   DateTime @default(now())
  lastLoginAt DateTime @default(now())
}

// A real per-user session, layered alongside (not replacing) the shared
// HMAC session the local password produces. AuthGuard accepts either.
model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model DutyRule {
  id String @id @default(cuid())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  weekday Weekday

  ruleType DutyRuleType

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([weekday])
}

model Holiday {
  id String @id @default(cuid())

  startDate DateTime
  endDate   DateTime
  name      String

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
  @@index([endDate])
  @@index([employeeId])
}

// Single-row settings table for the app-wide password lock. There is no
// per-user auth, so this is a shared password gating the whole app rather
// than a users table.
model AppSettings {
  id Int @id @default(1)

  lockEnabled  Boolean @default(false)
  passwordHash String?

  // Separate shared password gating the Settings page itself, so anyone who
  // unlocks the app with the main password still can't reach admin config
  // (Entra setup, the lock toggle) without also knowing this one.
  settingsPasswordHash String?

  // Microsoft Entra ID (Azure AD) SSO — baked in but inert until an admin
  // fills these in and flips entraEnabled on from the Settings page. Entra
  // login is an alternate way to obtain the same session cookie the local
  // password produces; it never replaces the local password.
  entraEnabled         Boolean @default(false)
  entraTenantId        String?
  entraClientId        String?
  // AES-256-GCM ciphertext ("iv:tag:ciphertext" hex), keyed by serverSecret.
  entraClientSecretEnc String?
  entraRedirectUri     String?

  // Email notifications — same "ships inert until configured" pattern as
  // Entra above. adminNotificationEmail is where roster-conflict alerts go;
  // duty reminders go to each Employee's own email instead.
  notificationsEnabled   Boolean @default(false)
  smtpHost               String?
  smtpPort               Int?
  smtpUser               String?
  smtpPasswordEnc        String?
  smtpFrom               String?
  adminNotificationEmail String?

  // Generated once and never exposed. Session tokens are
  // hmac(serverSecret, passwordHash), so rotating the password
  // automatically invalidates every previously issued session.
  serverSecret String

  updatedAt DateTime @updatedAt
}

model DutyAssignment {
  id String @id @default(cuid())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  start DateTime
  end   DateTime

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([employeeId])
  @@index([start])
  @@index([end])
}
